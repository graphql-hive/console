                {
                  "matcher": {
                    "id": "byName",
                    "options": "error.count"
                  },
                  "properties": [
                    {
                      "id": "displayName",
                      "value": "Error count"
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "Trace Service",
                    "scope": "series"
                  },
                  "properties": [
                    {
                      "id": "custom.width",
                      "value": 125
