# Mock mode: the app server hosts a fake GraphQL API at /graphql and no other backend runs.
# Loaded only by "pnpm dev:mock" (src/dev/mock-server/start.ts). Committed on purpose, no secrets.

APP_BASE_URL="http://localhost:3000"
ENVIRONMENT="development"
SERVER_HOST=::
SERVER_HOST_IPV6_ONLY=0

# Point the client at this server. Same origin, so the SuperTokens fetch interceptor
# sees its apiDomain and passes requests straight through.
GRAPHQL_PUBLIC_ENDPOINT="http://localhost:3000/graphql"
GRAPHQL_PUBLIC_SUBSCRIPTION_ENDPOINT="http://localhost:3000/graphql"
GRAPHQL_PUBLIC_ORIGIN="http://localhost:3000"
GRAPHQL_PERSISTED_OPERATIONS=0

# Every feature-shaped flag on, so every gated surface is reachable.
AUTH_GITHUB=1
AUTH_GOOGLE=1
AUTH_OKTA=0
AUTH_OKTA_HIDDEN=0
AUTH_ORGANIZATION_OIDC=1
AUTH_REQUIRE_EMAIL_VERIFICATION=0

INTEGRATION_SLACK=1
INTEGRATION_SLACK_CLIENT_ID="mock"
INTEGRATION_SLACK_CLIENT_SECRET="mock"
INTEGRATION_GITHUB_APP_NAME="hive-mock"

# Stripe.js only loads when NODE_ENV is production, so this never reaches Stripe.
STRIPE_PUBLIC_KEY="pk_test_mock"

ZENDESK_SUPPORT=1

# Telemetry stays off. Set explicitly: keys missing from this file fall through from the
# shell environment, so an exported SENTRY=1 would otherwise leak in.
SENTRY=0
SENTRY_DSN=
# Parsed by src/env/backend.ts but currently unused; pinned empty in case that changes.
GA_TRACKING_ID=

LOG_LEVEL=info
